{
  "name": "@monorch/example-hono-npm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Hono BYO HTTP consumer against published @monorch/ai from the npm registry (not the monorepo workspace).",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "smoke": "SMOKE=1 node --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@monorch/ai": "0.2.0",
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
