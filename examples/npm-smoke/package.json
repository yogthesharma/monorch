{
  "name": "@monorch/example-npm-smoke",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Consumer smoke against published @monorch/ai from the npm registry (not the monorepo workspace).",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "smoke": "SMOKE=1 node --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@monorch/ai": "0.2.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
