{
  "name": "@monorch/runtime",
  "version": "0.1.2",
  "description": "Prebuilt N-API bindings for the Monorch Rust engine (agents, tools, and graphs). Required by @monorch/ai.",
  "license": "MIT",
  "keywords": [
    "monorch",
    "napi",
    "rust",
    "ai",
    "agents",
    "native",
    "nodejs"
  ],
  "homepage": "https://monorch.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogthesharma/monorch.git",
    "directory": "bindings/node"
  },
  "bugs": {
    "url": "https://github.com/yogthesharma/monorch/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "create-npm-dir": "napi create-npm-dir -t .",
    "version": "napi version"
  },
  "napi": {
    "name": "monorch-runtime",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-pc-windows-msvc",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl"
      ]
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
