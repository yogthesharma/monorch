{
  "name": "@monorch/ai",
  "version": "0.1.2",
  "description": "AI control plane for TypeScript backends. Typed agents and graphs with a Rust engine, HITL checkpoints, MCP, and OpenAI-compatible streaming. Bring your own HTTP stack.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "tools",
    "mcp",
    "openai",
    "typescript",
    "rust",
    "graph",
    "workflow",
    "hitl",
    "checkpoint",
    "streaming",
    "zod",
    "control-plane"
  ],
  "homepage": "https://monorch.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogthesharma/monorch.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/yogthesharma/monorch/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:postgres": "node --experimental-strip-types --test test/postgres.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monorch/runtime": "workspace:*",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
